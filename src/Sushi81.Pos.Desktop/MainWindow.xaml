<Window x:Class="Sushi81.Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="980" Height="680" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility" /></Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding LanguageLabel}" />
        <ComboBox Width="150" Height="28" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding CanChangeLanguage}" DisplayMemberPath="DisplayName" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=OneWay}" SelectionChanged="OnLanguageSelectionChanged" />
      </StackPanel>
      <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" />
    </DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
    <TabControl Grid.Row="1" DataContext="{Binding Admin}" IsEnabled="{Binding IsM03Available, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding IsM03Available, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
      <TabItem Header="{Binding DataContext.Localized[Catalogue], RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.Localized[Search], RelativeSource={RelativeSource AncestorType=Window}}" />
            <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding CategoryFilters}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="120" Margin="0,0,8,0" ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedStatusKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Padding="12,4" Content="↻" Click="OnRefreshCatalogue" />
          </WrapPanel>
          <DataGrid x:Name="catalogueGrid" Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="OnEditProduct">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Opacity" Value="0.58" /><Setter Property="FontStyle" Value="Italic" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="" Width="110" Binding="{Binding Code}" />
              <DataGridTextColumn Header="" Width="2*" Binding="{Binding Name}" />
              <DataGridTextColumn Header="" Width="1.5*" Binding="{Binding CategoryName}" />
              <DataGridTextColumn Header="" Width="110" Binding="{Binding PriceTtc.Euros, StringFormat=F2}" />
              <DataGridTextColumn Header="" Width="90" Binding="{Binding VatRate, StringFormat=F1}" />
              <DataGridCheckBoxColumn Header="" Width="90" Binding="{Binding IsActive}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Text="{Binding DataContext.Localized[EmptyCatalogue], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProducts}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[NewProduct], RelativeSource={RelativeSource AncestorType=Window}}" Click="OnNewProduct" />
            <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[Edit], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanEditProduct}" Click="OnEditProduct" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding ToggleProductActionLabel}" IsEnabled="{Binding CanToggleProduct}" Click="OnToggleProduct" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[BulkActivate], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanBulkActivate}" Click="OnBulkActivate" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[BulkDeactivate], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanBulkDeactivate}" Click="OnBulkDeactivate" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[DeletePermanently], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanDeleteProduct}" Click="OnDeleteProduct" />
            <Button Padding="12,4" Content="{Binding DataContext.Localized[ManageCategories], RelativeSource={RelativeSource AncestorType=Window}}" Click="OnManageCategories" />
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding DataContext.Localized[Settings], RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Margin="18" MaxWidth="520">
          <TextBlock Text="{Binding SettingsValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Text="{Binding DataContext.Localized[PickupDiscount], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding PickupDiscountRateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[PickupMinimum], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding PickupDiscountMinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[DeliveryMinimum], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding DeliveryMinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
          <CheckBox Content="{Binding DataContext.Localized[DeliveryFeeEnabled], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding DeliveryFeeEnabled}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[DeliveryFee], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding DeliveryFeeAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[DeliveryFeeVatFixed], RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0.7" Margin="0,0,0,14" />
          <WrapPanel><Button Content="{Binding DataContext.Localized[Save], RelativeSource={RelativeSource AncestorType=Window}}" Padding="16,5" Margin="0,0,8,0" Click="OnSaveSettings" /><Button Content="{Binding DataContext.Localized[Cancel], RelativeSource={RelativeSource AncestorType=Window}}" Padding="16,5" Click="OnReloadSettings" /></WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="{Binding DataContext.Localized[Caisse], RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding DataContext.Entry, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsM04Available, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid Margin="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel Grid.Column="0" Margin="0,0,10,8">
            <TextBox Width="180" Margin="0,0,6,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.Localized[OrderSearch], RelativeSource={RelativeSource AncestorType=Window}}" />
            <ComboBox Width="150" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCategoryId}" />
          </WrapPanel>
          <DataGrid x:Name="orderProductsGrid" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="OnAddOrderProduct">
            <DataGrid.Columns><DataGridTextColumn Header="{Binding DataContext.Localized[Code], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Code}" Width="90" /><DataGridTextColumn Header="{Binding DataContext.Localized[Name], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="{Binding DataContext.Localized[PriceTtc], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding PriceTtc.Euros, StringFormat=F2}" Width="80" /></DataGrid.Columns>
          </DataGrid>
          <Button Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" Padding="14,5" Content="{Binding DataContext.Localized[Add], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanAddSelectedProduct}" Click="OnAddOrderProduct" />

          <Grid Grid.Column="1" Grid.RowSpan="3" Margin="10,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1.2*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding DataContext.Localized[Cart], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
            <ListBox x:Name="orderCartList" Grid.Row="1" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCartLine}" BorderThickness="1" MouseDoubleClick="OnEditOrderLine">
              <ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Configuration}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="Qté: {Binding Quantity}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding LineTotalText, StringFormat={}{0} €}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" /><Button Grid.Column="2" Content="−" Tag="{Binding}" Click="OnDecreaseOrderQuantity" /><Button Grid.Column="3" Content="+" Tag="{Binding}" Click="OnIncreaseOrderQuantity" /><Button Grid.Column="4" Content="×" Tag="{Binding}" Click="OnRemoveOrderLine" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Separator Grid.Row="2" Margin="0,8" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{Binding DataContext.Localized[Fulfilment], RelativeSource={RelativeSource AncestorType=Window}}" Width="105" VerticalAlignment="Center" /><ComboBox Width="145" ItemsSource="{Binding FulfilmentChoices}" SelectedItem="{Binding SelectedFulfilment}" /></StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{Binding DataContext.Localized[PlannedDate], RelativeSource={RelativeSource AncestorType=Window}}" Width="105" VerticalAlignment="Center" /><DatePicker Width="145" SelectedDate="{Binding PlannedDate}" /></StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{Binding DataContext.Localized[Telephone], RelativeSource={RelativeSource AncestorType=Window}}" Width="105" VerticalAlignment="Center" /><TextBox Width="145" Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{Binding DataContext.Localized[DeliveryAddress], RelativeSource={RelativeSource AncestorType=Window}}" Width="105" VerticalAlignment="Center" /><TextBox Width="145" Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{Binding DataContext.Localized[PlannedTime], RelativeSource={RelativeSource AncestorType=Window}}" Width="105" VerticalAlignment="Center" /><TextBox Width="145" Text="{Binding PlannedTimeText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Row="8" Margin="0,0,0,6"><TextBlock Text="{Binding DataContext.Localized[Comment], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,6"><CheckBox Content="{Binding DataContext.Localized[PickupDiscountRequest], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding PickupDiscountRequested}" /></StackPanel>
            <StackPanel Grid.Row="10"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DataContext.Localized[TotalTtc], RelativeSource={RelativeSource AncestorType=Window}}" Width="105" VerticalAlignment="Center" /><TextBox x:Name="orderTotalBox" Width="145" Text="{Binding TotalText, Mode=OneWay}" LostFocus="OnManualOrderTotalChanged" /></StackPanel><TextBlock Text="{Binding ValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,5,0,0" /><WrapPanel Margin="0,6,0,0"><Button Padding="12,4" Content="{Binding DataContext.Localized[Confirm], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanConfirm}" Click="OnConfirmOrder" /><TextBlock Text="{Binding CommittedMessage}" Margin="8,4,0,0" TextWrapping="Wrap" /></WrapPanel></StackPanel>
            <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,6,0,0"><TextBox Width="145" Text="{Binding ReloadOrderIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ID commande" /><Button Content="{Binding DataContext.Localized[ReloadOrder], RelativeSource={RelativeSource AncestorType=Window}}" Margin="6,0,0,0" Padding="8,3" Click="OnReloadOrder" /></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</Window>
