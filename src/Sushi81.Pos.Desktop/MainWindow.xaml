<Window x:Class="Sushi81.Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sushi81.Pos.Desktop"
        Title="{Binding Title}" Width="980" Height="680" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" SizeChanged="OnMainWindowSizeChanged">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility" /></Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding LanguageLabel}" />
        <ComboBox Width="150" Height="28" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding CanChangeLanguage}" DisplayMemberPath="DisplayName" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=OneWay}" SelectionChanged="OnLanguageSelectionChanged" />
      </StackPanel>
      <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" />
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Border Background="#FFFFE0" BorderBrush="#FFD08A" BorderThickness="1" Padding="8" Margin="0,6,0,0" Visibility="{Binding IsAuthorityWarningVisible, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding AuthorityStatus}" TextWrapping="Wrap" Foreground="#7A4300" />
      </Border>
    </StackPanel>
    <TabControl x:Name="mainTabs" Grid.Row="2" DataContext="{Binding Admin}" SelectionChanged="OnMainTabsSelectionChanged" IsEnabled="{Binding IsM03Available, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding IsM03Available, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
      <TabItem Header="{Binding DataContext.Localized[Catalogue], RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.Localized[Search], RelativeSource={RelativeSource AncestorType=Window}}" />
            <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding CategoryFilters}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="120" Margin="0,0,8,0" ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedStatusKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Padding="12,4" Content="↻" Click="OnRefreshCatalogue" />
          </WrapPanel>
          <DataGrid x:Name="catalogueGrid" Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="OnEditProduct">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Opacity" Value="0.58" /><Setter Property="FontStyle" Value="Italic" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="" Width="110" Binding="{Binding Code}" />
              <DataGridTextColumn Header="" Width="2*" Binding="{Binding Name}" />
              <DataGridTextColumn Header="" Width="1.5*" Binding="{Binding CategoryName}" />
              <DataGridTextColumn Header="" Width="110" Binding="{Binding PriceTtc.Euros, StringFormat=F2}" />
              <DataGridTextColumn Header="" Width="90" Binding="{Binding VatRate, StringFormat=F1}" />
              <DataGridCheckBoxColumn Header="" Width="90" Binding="{Binding IsActive}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Text="{Binding DataContext.Localized[EmptyCatalogue], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProducts}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[NewProduct], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanCreateProduct}" Click="OnNewProduct" />
            <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[Edit], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanEditProduct}" Click="OnEditProduct" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding ToggleProductActionLabel}" IsEnabled="{Binding CanToggleProduct}" Click="OnToggleProduct" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[BulkActivate], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanBulkActivate}" Click="OnBulkActivate" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[BulkDeactivate], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanBulkDeactivate}" Click="OnBulkDeactivate" />
             <Button Margin="0,0,8,0" Padding="12,4" Content="{Binding DataContext.Localized[DeletePermanently], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanDeleteProduct}" Click="OnDeleteProduct" />
            <Button Padding="12,4" Content="{Binding DataContext.Localized[ManageCategories], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanManageCategories}" Click="OnManageCategories" />
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding DataContext.Localized[Settings], RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Margin="18" MaxWidth="520" IsEnabled="{Binding CanWrite}">
          <TextBlock Text="{Binding SettingsValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Text="{Binding DataContext.Localized[PickupDiscount], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding PickupDiscountRateText, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" Margin="0,4,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[PickupMinimum], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding PickupDiscountMinText, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" Margin="0,4,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[DeliveryMinimum], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding DeliveryMinText, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" Margin="0,4,0,12" />
          <CheckBox Content="{Binding DataContext.Localized[DeliveryFeeEnabled], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding DeliveryFeeEnabled}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[DeliveryFee], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Text="{Binding DeliveryFeeAmountText, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" Margin="0,4,0,12" />
          <TextBlock Text="{Binding DataContext.Localized[DeliveryFeeVatFixed], RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0.7" Margin="0,0,0,14" />
          <WrapPanel><Button Content="{Binding DataContext.Localized[Save], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanSaveSettings}" Padding="16,5" Margin="0,0,8,0" Click="OnSaveSettings" /><Button Content="{Binding DataContext.Localized[Cancel], RelativeSource={RelativeSource AncestorType=Window}}" Padding="16,5" Click="OnReloadSettings" /></WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="{Binding DataContext.Localized[Commandes], RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding DataContext.Lifecycle, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsM05Available, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="3*" /><RowDefinition Height="4*" /></Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="commandesSearchBox" Width="240" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.Localized[OrderSearchHint], RelativeSource={RelativeSource AncestorType=Window}}" TextChanged="OnCommandesSearchChanged" />
            <DatePicker Width="145" SelectedDate="{Binding BrowseDate, Mode=TwoWay}" Margin="0,0,8,0" />
            <Button x:Name="commandesBrowseByDateButton" Content="{Binding DataContext.Localized[OrderBrowseByDate], RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,3" Margin="0,0,8,0" Click="OnBrowseByDate" />
            <Button Content="{Binding DataContext.Localized[DashboardRefresh], RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,3" Click="OnRefreshCommandes" />
          </WrapPanel>
          <DataGrid x:Name="commandesGrid" Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MinHeight="140" Margin="0,0,0,8" Loaded="OnCommandesGridLoaded" SizeChanged="OnCommandesGridSizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="" Binding="{Binding ReferenceText}" Width="120" />
              <DataGridTextColumn Header="" Binding="{Binding PlannedDateText}" Width="100" />
              <DataGridTextColumn Header="" Binding="{Binding PlannedTimeText}" Width="65" />
              <DataGridTextColumn Header="" Binding="{Binding StatusText}" Width="95" />
              <DataGridTextColumn Header="" Binding="{Binding TotalText, StringFormat={}{0} €}" Width="95" />
              <DataGridTextColumn Header="" Binding="{Binding TelephoneText}" Width="150" />
              <DataGridTextColumn Header="" Binding="{Binding FulfilmentText}" Width="100" />
              <DataGridTextColumn Header="" Binding="{Binding CommentText}" Width="2*" MinWidth="180" />
              <DataGridTextColumn Header="" Binding="{Binding AddressText}" Width="2*" MinWidth="180" />
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="{Binding DataContext.Localized[OrderNoSelection], RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedOrder}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <Grid IsEnabled="{Binding HasSelectedOrder}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6"><TextBlock Text="{Binding ReferenceText}" FontSize="19" FontWeight="SemiBold" /><WrapPanel><TextBlock Text="{Binding AdvanceText}" Margin="0,0,10,0" /><TextBlock Text="{Binding ManualTotalText}" Margin="0,0,10,0" /><TextBlock Text="{Binding PickupDiscountText}" Margin="0,0,10,0" /><TextBlock Text="{Binding DataContext.Localized[TaxSnapshot], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBlock Text=": " /><TextBlock Text="{Binding TaxSummaryText}" /></WrapPanel></StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding DataContext.Localized[OrderStatus], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" />
                <TextBlock Grid.Row="2" Text="{Binding DataContext.Localized[Fulfilment], RelativeSource={RelativeSource AncestorType=Window}}" /><ComboBox Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" ItemsSource="{Binding FulfilmentChoices}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding EditFulfilment, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" />
                <CheckBox Grid.Row="3" Grid.Column="1" Content="{Binding DataContext.Localized[PickupDiscountRequest], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding EditPickupDiscountRequested, Mode=TwoWay}" IsEnabled="{Binding IsEditPickupDiscountEnabled}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="4" Text="{Binding DataContext.Localized[PlannedDate], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" /><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><DatePicker x:Name="lifecycleEditPlannedDatePicker" Width="145" HorizontalAlignment="Left" SelectedDate="{Binding EditPlannedDate, Mode=TwoWay}" DisplayDateStart="{Binding MinimumEditPlannedDate, Mode=OneWay}" IsEnabled="{Binding IsEditing}" /><ComboBox Width="48" Margin="6,0,0,0" ItemsSource="{Binding PlannedHourChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditPlannedHour, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" /><TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" /><ComboBox Width="48" ItemsSource="{Binding PlannedMinuteChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditPlannedMinute, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" /></StackPanel>
                <TextBlock Grid.Row="5" Text="{Binding DataContext.Localized[Telephone], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox Grid.Row="5" Grid.Column="1" Width="170" HorizontalAlignment="Left" Text="{Binding EditTelephone, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditing}" />
                <TextBlock Grid.Row="6" Text="{Binding DataContext.Localized[DeliveryAddress], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" /><TextBox x:Name="lifecycleEditAddressBox" Grid.Row="6" Grid.Column="1" Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditing}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" />
                <TextBlock Grid.Row="7" Text="{Binding DataContext.Localized[Comment], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" /><TextBox x:Name="lifecycleEditCommentBox" Grid.Row="7" Grid.Column="1" Text="{Binding EditComment, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditing}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" />
                <TextBlock Grid.Row="8" Text="{Binding DataContext.Localized[OrderLines], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" /><StackPanel Grid.Row="8" Grid.Column="1"><ListBox x:Name="lifecycleDetailLinesList" ItemsSource="{Binding DetailLines}" MinHeight="60" MaxHeight="145" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" MinWidth="0"><TextBlock Text="{Binding ProductText}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding PriceBreakdownText}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding OptionsText}" FontSize="11" TextWrapping="Wrap" /></StackPanel><Grid Grid.Column="1" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><Button Grid.Column="0" Width="32" Height="28" Content="−" Tag="{Binding}" Click="OnDecreaseLifecycleQuantity" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="4,0,0,0" /><Button Grid.Column="1" Width="32" Height="28" Content="+" Tag="{Binding}" Click="OnIncreaseLifecycleQuantity" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="4,0,0,0" /><Button Grid.Column="2" Width="32" Height="28" Content="✎" Tag="{Binding}" Click="OnReconfigureOrderLine" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="4,0,0,0" /><Button Grid.Column="3" Width="32" Height="28" Content="×" Tag="{Binding}" Click="OnRemoveLifecycleLine" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="4,0,0,0" /></Grid></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="{Binding DataContext.Localized[Add], RelativeSource={RelativeSource AncestorType=Window}}" Click="OnAddCurrentOrderLine" IsEnabled="{Binding CanAddCurrentLine}" HorizontalAlignment="Left" Padding="8,3" /></StackPanel>
                <TextBlock Grid.Row="9" Text="{Binding DataContext.Localized[TotalTtc], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox x:Name="lifecycleEditTotalBox" Grid.Row="9" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding EditTotal, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" IsEnabled="{Binding IsEditing}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="10" Text="{Binding DataContext.Localized[OrderCard], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox x:Name="lifecycleEditCardBox" Grid.Row="10" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding EditCard, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" IsEnabled="{Binding IsEditing}" />
                <TextBlock Grid.Row="11" Text="{Binding DataContext.Localized[OrderCash], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox x:Name="lifecycleEditCashBox" Grid.Row="11" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding EditCash, UpdateSourceTrigger=PropertyChanged}" local:NumericInputBehavior.SelectAllOnFocus="True" IsEnabled="{Binding IsEditing}" />
                <TextBlock x:Name="lifecycleEffectivePaymentDateLabel" Grid.Row="12" Text="{Binding DataContext.Localized[OrderEffectiveDateEdit], RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                <Grid x:Name="lifecycleEffectivePaymentDatePanel" Grid.Row="12" Grid.Column="1" HorizontalAlignment="Left" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DatePicker x:Name="lifecycleEffectivePaymentDatePicker" Grid.Row="0" Width="145" HorizontalAlignment="Left" SelectedDate="{Binding EffectivePaymentDate, Mode=TwoWay}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsEditing}" /><TextBlock x:Name="lifecycleEffectivePaymentDateHint" Grid.Row="1" Text="{Binding DataContext.Localized[OrderEffectiveDateHint], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" /></Grid>
                <TextBlock Grid.Row="13" Text="{Binding DataContext.Localized[OrderPaid], RelativeSource={RelativeSource AncestorType=Window}}" /><TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding EditPaidText, StringFormat={}{0} €}" />
                <TextBlock Grid.Row="14" Text="{Binding DataContext.Localized[OrderDifference], RelativeSource={RelativeSource AncestorType=Window}}" /><StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding EditDifferenceText, StringFormat={}{0} €}" /><TextBlock Text="{Binding EditCloseEligibilityText}" Foreground="DarkGreen" Margin="10,0,0,0" /></StackPanel>
              </Grid>
              <TextBlock Text="{Binding ValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,4" />
              <WrapPanel Margin="0,4,0,0">
                <Button Content="{Binding DataContext.Localized[OrderModify], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanModify}" Click="OnModifyOrder" Padding="10,4" Margin="0,0,6,4" />
                <Button Content="{Binding DataContext.Localized[OrderSave], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanSave}" Click="OnSaveOrderModification" Padding="10,4" Margin="0,0,6,4" />
                <Button Content="{Binding DataContext.Localized[OrderAbandon], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanAbandon}" Click="OnAbandonOrderModification" Padding="10,4" Margin="0,0,6,4" />
                <Button Content="{Binding DataContext.Localized[OrderClose], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanClose}" Click="OnCloseOrder" Padding="10,4" Margin="0,0,6,4" />
                <Button Content="{Binding DataContext.Localized[OrderCancel], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanCancel}" Click="OnCancelOrder" Padding="10,4" Margin="0,0,6,4" />
                <Button Content="{Binding DataContext.Localized[OrderNewFromDetails], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanReuseCustomer}" Click="OnReuseOrderCustomer" Padding="10,4" Margin="0,0,6,4" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding DataContext.Localized[Caisse], RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding DataContext.Entry, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.IsM04Available, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
          <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Button x:Name="dashboardFutureButton" Tag="future" Content="{Binding DataContext.Localized[DashboardFuture], RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,3" Margin="0,0,2,0" Click="OnDashboardEntry" /><TextBlock x:Name="dashboardFutureCountText" Text="{Binding DataContext.Lifecycle.FutureOrderCount, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="DarkRed" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Tag="due" Content="{Binding DataContext.Localized[DashboardDueToday], RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,3" Margin="0,0,2,0" Click="OnDashboardEntry" /><TextBlock x:Name="dashboardDueCountText" Text="{Binding DataContext.Lifecycle.DueTodayAdvanceOrderCount, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="DarkRed" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Tag="overdue" Content="{Binding DataContext.Localized[DashboardOverdue], RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,3" Margin="0,0,2,0" Click="OnDashboardEntry" /><TextBlock x:Name="dashboardOverdueCountText" Text="{Binding DataContext.Lifecycle.OverdueUnsettledOrderCount, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="DarkRed" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding DataContext.Localized[DashboardTurnover], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" /><TextBlock Text=" : " VerticalAlignment="Center" /><TextBlock x:Name="dashboardTurnoverText" Text="{Binding DataContext.Lifecycle.DashboardTurnoverText, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding DataContext.Localized[DashboardReceived], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" /><TextBlock Text=" : " VerticalAlignment="Center" /><TextBlock x:Name="dashboardReceivedText" Text="{Binding DataContext.Lifecycle.DashboardReceivedText, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding DataContext.Localized[DashboardReceivedCard], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" /><TextBlock Text=" : " VerticalAlignment="Center" /><TextBlock x:Name="dashboardReceivedCardText" Text="{Binding DataContext.Lifecycle.DashboardReceivedCardText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="DarkBlue" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Text="{Binding DataContext.Localized[DashboardReceivedCash], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" /><TextBlock Text=" : " VerticalAlignment="Center" /><TextBlock x:Name="dashboardReceivedCashText" Text="{Binding DataContext.Lifecycle.DashboardReceivedCashText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="DarkGreen" VerticalAlignment="Center" />
            <Button Content="{Binding DataContext.Localized[DashboardRefresh], RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,3" Margin="12,0,0,0" Click="OnRefreshDashboard" />
          </WrapPanel>
          <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" BorderBrush="#FFD6D6D6" BorderThickness="0,0,1,0" Padding="0,0,10,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="{Binding DataContext.Localized[Products], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="132" MinWidth="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{Binding DataContext.Localized[Category], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <ListBox x:Name="orderCategoriesList" Grid.Row="1" ItemsSource="{Binding Categories}" DisplayMemberPath="NavigationLabel" SelectedValuePath="Id" SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
                <Grid Grid.Column="1">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBox x:Name="orderProductSearchBox" Grid.Row="0" Margin="0,0,0,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.Localized[OrderSearch], RelativeSource={RelativeSource AncestorType=Window}}" />
                  <DataGrid x:Name="orderProductsGrid" Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="OnAddOrderProduct">
                    <DataGrid.Columns><DataGridTextColumn Header="" Binding="{Binding Code}" Width="78" /><DataGridTextColumn Header="" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="" Binding="{Binding PriceTtc.Euros, StringFormat=F2}" Width="78" /></DataGrid.Columns>
                  </DataGrid>
                  <Button x:Name="orderAddButton" Grid.Row="2" HorizontalAlignment="Left" Padding="14,5" Margin="0,8,0,0" Content="{Binding DataContext.Localized[Add], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanAddSelectedProduct}" Click="OnAddOrderProduct" />
                </Grid>
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="3*" /><RowDefinition Height="4*" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="{Binding DataContext.Localized[Cart], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
            <ListBox x:Name="orderCartList" Grid.Row="1" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCartLine}" BorderThickness="1" MinHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnEditOrderLine">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Grid Margin="4" MinHeight="48">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="88" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,6,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Configuration}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding QuantityDisplayText}" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LineTotalText, StringFormat={}{0} €}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                <Button Grid.Column="2" Width="34" Height="30" Content="−" Tag="{Binding}" Click="OnDecreaseOrderQuantity" />
                <Button Grid.Column="3" Width="34" Height="30" Content="+" Tag="{Binding}" Click="OnIncreaseOrderQuantity" />
                <Button Grid.Column="4" Width="34" Height="30" Content="×" Tag="{Binding}" Click="OnRemoveOrderLine" />
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanWrite}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Separator Grid.Row="0" Margin="0,8" />
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DataContext.Localized[Fulfilment], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,8,6" />
                  <ComboBox x:Name="orderFulfilmentBox" Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="0,0,0,6" ItemsSource="{Binding FulfilmentChoices}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding SelectedFulfilment, Mode=TwoWay}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DataContext.Localized[PlannedDate], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,8,6" />
                  <DatePicker x:Name="orderPlannedDatePicker" Grid.Row="1" Grid.Column="1" Width="145" HorizontalAlignment="Left" Margin="0,0,0,6" SelectedDate="{Binding PlannedDate, Mode=TwoWay}" DisplayDateStart="{Binding MinimumPlannedDate, Mode=OneWay}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DataContext.Localized[Telephone], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,8,6" />
                  <TextBox x:Name="orderTelephoneBox" Grid.Row="2" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,0,0,6" Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DataContext.Localized[DeliveryAddress], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" Margin="0,3,8,6" />
                  <TextBox x:Name="orderDeliveryAddressBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding DataContext.Localized[PlannedTime], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,8,6" />
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox x:Name="plannedHourBox" Width="72" ItemsSource="{Binding PlannedHourChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPlannedHour, Mode=TwoWay}" ToolTip="{Binding DataContext.Localized[TimeHour], RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0" />
                    <ComboBox x:Name="plannedMinuteBox" Width="72" ItemsSource="{Binding PlannedMinuteChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPlannedMinute, Mode=TwoWay}" ToolTip="{Binding DataContext.Localized[TimeMinute], RelativeSource={RelativeSource AncestorType=Window}}" />
                  </StackPanel>
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding DataContext.Localized[Comment], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" Margin="0,3,8,6" />
                  <TextBox x:Name="orderCommentBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                  <CheckBox Grid.Row="6" Grid.Column="1" Content="{Binding DataContext.Localized[PickupDiscountRequest], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding PickupDiscountRequested}" IsEnabled="{Binding IsPickupDiscountEnabled}" Margin="0,0,0,8" />
                  <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DataContext.Localized[TotalTtc], RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox x:Name="orderTotalBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" local:NumericInputBehavior.SelectAllOnFocus="True" Margin="0,0,0,4" Text="{Binding TotalText, Mode=OneWay}" LostFocus="OnManualOrderTotalChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ManualTotalStateText}" Visibility="{Binding IsManualTotalOverrideActive, Converter={StaticResource BoolToVisibility}}" Foreground="DarkOrange" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,2,0,3" />
                    <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,0"><Button MinHeight="32" Padding="12,4" Content="{Binding DataContext.Localized[Confirm], RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanConfirm}" Click="OnConfirmOrder" /><Button MinHeight="32" Padding="12,4" Margin="6,0,0,0" Content="{Binding NewOrderLabel}" IsEnabled="{Binding CanStartNewOrder}" Click="OnNewOrder" /><TextBlock Text="{Binding CommittedMessage}" Margin="8,6,0,0" TextWrapping="Wrap" /></WrapPanel>
                  </Grid>
                </Grid>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
